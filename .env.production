# Production Environment Configuration
# IMPORTANT: Set these values in your production hosting platform (Vercel, Render, etc.)

# Paystack Payment Gateway
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret_here

# Database
DATABASE_URL=your_production_database_url_here

# Google Maps (Optional)
NEXT_PUBLIC_GOOGLE_MAPS_PLATFORM_KEY=your_google_maps_key_here

# Node Environment
NODE_ENV=production
